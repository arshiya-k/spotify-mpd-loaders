# Copy to .env and adjust. .env is gitignored.
MPD_DATA_DIR=/absolute/path/to/spotify_project/data/data

# Native Postgres (see pg.sh) -- use this for benchmarking. Docker Desktop on macOS
# routes all DB traffic through a VM and caps multi-writer throughput.
DATABASE_URL=postgresql://mpd@localhost:5433/mpd
# Docker Postgres (docker compose up -d):
# DATABASE_URL=postgresql://mpd:mpd@localhost:5432/mpd
